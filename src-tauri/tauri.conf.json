{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows App Group Sidebar",
  "version": "0.1.0",
  "identifier": "com.amir.windows-app-group-sidebar",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windows App Group Sidebar",
        "width": 260,
        "height": 1000,
        "x": 2300,
        "y": 0,
        "minWidth": 180,
        "maxWidth": 700,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
